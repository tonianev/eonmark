// Easy (M6): a defensive bot for learning the loop. It receives a bonus
// bundle every 30 s from 3:00 (the first one at 3:30), sends waves only after
// the Masonry Age and only at its largest wave size (at most 14 armed units),
// 1.5 times as far apart, and goes all-in from minute 40. No early raid.
// Its disclosed handicap (M6 owner decision 2's fallback, since ROADMAP M6
// line 2 does not pass under the bonus ceiling): 15% fewer Yeomen.
// Disclosed on New Game and on the game-over screen; never rubber-banded.
// Schema: crates/rules/src/ai.rs (deny_unknown_fields). docs/design/ai.md,
// "Difficulty table".
(
  id: "easy", name: "Easy",
  income_interval_ds: 300,
  income_from_ds: 1800,
  income: {"grain": 20, "lumber": 20, "ore": 10},   // the same in all three files
  wave_age_gate: Age("masonry"),
  largest_wave_only: true,
  max_wave_units: Some(14),
  wave_size_permille: 1000,
  wave_interval_permille: 1500,
  all_in_after_ds: Some(24000),                     // 40:00
  first_raid: None,
  worker_target_permille: 850,                      // every Workers count x 0.85, rounded up
  pressure: (
    reinforce_min_units: 0,
    commit_ds: 0,
    retreat_ratio_permille: 1000,
    retreat_cooldown_permille: 1000,
    home_guard_units: 0,
    lure_ds: 0,
    cohesion_tiles: 0,
    launch_ratio_permille: 0,
  ),
)
