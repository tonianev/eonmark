// UI strings, English (M3b). Presentation only: the sim never reads this
// file, it is not part of rules_hash, and editing it needs no rules_version
// bump. Schema: crates/rules/src/strings.rs (deny_unknown_fields).
// Placeholders: {resource} {unit} {building} {cost} {used} {cap} {count}
// {rate} {name} {key} {time} {hash} {seed}; any other brace fails
// `sim-cli data-check`.
(
  // Message line, one entry per sim RejectReason in snake case.
  reject: {
    "unknown_player": "Unknown player",
    "surrendered": "You have surrendered",
    "no_valid_units": "No selected unit can do that",
    "debug_commands_disabled": "Debug commands are off in this match",
    "unknown_unit_kind": "Unknown unit",
    "unreachable": "Cannot get there",
    "outside_borders": "Outside your borders",
    "cannot_afford": "Not enough {resource}",
    "town_limit_reached": "Town limit reached",
    "per_town_limit_reached": "This Town already has its limit of those",
    "unknown_building_kind": "Unknown building",
    "unknown_building": "That building is gone",
    "unknown_resource": "Unknown resource",
    "not_a_builder": "That unit cannot build",
    "site_out_of_bounds": "Off the map",
    "site_blocked": "Something is in the way",
    "site_occupied": "Units are standing there",
    "no_adjacent_resource": "Must be built beside its resource",
    "invalid_slot": "Nothing to cancel there",
    "under_construction": "Still under construction",
    "not_a_gather_node": "Nothing to gather there",
    "pop_cap_reached": "Population cap reached",
    "cannot_train_here": "Cannot be trained here",
    "queue_full": "Queue full",
    "no_free_slot": "No free work slot",
    "unknown_tech": "Unknown tech",
    "cannot_research_here": "Cannot be researched here",
    "prerequisite_missing": "Needs a tech you have not researched",
    "age_required": "Not available in this age",
    "already_researched": "Already researched",
    "research_in_progress": "Already being researched",
    "not_enough_techs": "Research more techs first",
    "final_age": "Already in the last age",
    "player_mismatch": "That order is for another player",
    "invalid_target": "Cannot attack that",
    "town_contested": "This Town is being annexed",
  },
  // HUD labels and tooltips.
  hud: {
    "pop": "Pop {used} / {cap}",
    "rate": "+{rate} / 30 s",
    "rate.capped": "+{rate} / 30 s, capped at {cap}",
    "stockpile.capped": "{count} / {cap}",
    "button.stop": "Stop",
    "button.build": "Build",
    "button.back": "Back",
    "button.train": "{unit}",
    "button.building": "{building}",
    "button.cancel": "Cancel",
    "tooltip.cost": "Costs {cost}",
    "tooltip.place": "Place {building}: left click inside your borders, right click or Esc to cancel",
    "tooltip.cancel_site": "Cancel construction and refund what was paid",
    "info.units": "{name} x{count}",
    "info.more_kinds": "+{count} more kinds",
    "info.site": "Under construction, {count}%",
    "info.seat": "Seat, tier {count}",
    "info.town": "Town, tier {count}",
    "info.workers": "Workers {count} / {cap}",
    "info.queue": "Queue: {name}",
    "info.hp": "HP {count} / {cap}",
    "button.attack_move": "Attack-move",
    "tooltip.attack_move": "Attack-move (A): left click a point; armed units fight what they meet on the way. Right click or Esc to cancel",
    "age": "{name}",
    "button.advance": "Advance to {name}",
    "button.advance_techs": "Advance: {count} / {cap} techs",
    "tooltip.techs": "{count} / {cap} techs researched",
    "button.research": "{name}",
    "button.needs": "Needs {name}",
    "button.researching": "Researching {count}%",
    "button.researched": "Researched",
    "tooltip.research": "Research {name}, {count} s",
    "tooltip.requires": "Requires {name}",
    "info.researched": "Researched: {name}",
    "notice.placed": "{building} placed",
    "notice.completed": "{building} complete",
    "notice.researched": "{name} researched",
    "notice.age": "{name} reached",
    "notice.destroyed": "{building} destroyed",
    "notice.lost": "{building} lost",
    "notice.town_down": "{building} has fallen",
    "notice.annexation_started": "{building} is being annexed",
    "notice.annexation_stopped": "Annexation stopped",
    "notice.annexed": "Town annexed",
    "notice.town_lost": "{building} was lost",
    "annex.attacking": "Annexing {building}: {time}",
    "annex.defending": "{building} is being annexed: {time}",
    "outcome.victory": "Victory",
    "outcome.defeat": "Defeat",
    "outcome.draw": "Draw",
    // Spectating: the winning seat instead of Victory or Defeat (M6).
    "outcome.blue_wins": "Blue wins",
    "outcome.red_wins": "Red wins",
    "outcome.seat_captured": "The Seat was captured",
    "outcome.all_towns_lost": "Every Town was lost",
    "outcome.surrender": "Surrender",
    "outcome.territory": "Territory at the time limit: {count} tiles to {cap}",
    "outcome.time": "{time}, tick {count}",
    "outcome.hash": "Final hash {hash}",
    "outcome.replay": "Replay {name}",
    // M5b: the main menu on a plain launch (`menu/main_menu.rs`); {name}
    // is the map's name.
    "menu.title": "Eonmark",
    "menu.opponent": "Skirmish on {name}",
    "menu.seed": "Seed {seed}",
    "menu.new_game": "New Game",
    "menu.quit": "Quit",
    // M6: the New Game selector (`menu/new_game.rs`), the game-over screen
    // (`outcome.rs`), the under-attack alert and the top bar's tiebreak
    // race (`alert.rs`), and the pause banner (`speed.rs`).
    "menu.difficulty": "Difficulty",
    "menu.style": "Opponent style",
    "menu.new_seed": "New seed",
    "menu.disclosure": "The bot knows where your Seat is",
    "game_over.you": "You",
    "game_over.blue": "Blue",
    "game_over.red": "Red",
    "game_over.result": "Result",
    "game_over.decisive": "Decisive",
    "game_over.tiebreak": "Tiebreak, territory {count}% to {cap}%",
    "game_over.units_trained": "Units trained",
    "game_over.units_lost": "Units lost",
    "game_over.towns": "Towns taken / lost",
    "game_over.ages": "Ages reached",
    "game_over.capped": "Income capped",
    "game_over.peak_army": "Peak army",
    "game_over.bonus": "Bonus income",
    "game_over.waves": "Waves · raids · retreats",
    "game_over.enemy_on_land": "Enemy first on your land",
    "game_over.lowest_town": "Your lowest Town",
    // Spectating (both seats bots), the facts name the seats.
    "game_over.red_on_blue_land": "Red first on Blue's land",
    "game_over.blue_lowest_town": "Blue's lowest Town",
    "game_over.first_contact": "First contact",
    "game_over.annexed": "annexed",
    "game_over.never": "never",
    "game_over.play_again": "Play Again",
    "game_over.main_menu": "Main Menu",
    "game_over.quit": "Quit",
    "alert.civilian": "Yeomen under attack",
    "alert.army": "Army under attack",
    "alert.building": "{building} under attack",
    "top.tiebreak": "Tiebreak {time} · You {count}% · Bot {cap}%",
    "top.tiebreak_spectate": "Tiebreak {time} · Blue {count}% · Red {cap}%",
    "speed.paused": "PAUSED",
  },
)
